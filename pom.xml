<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ro.tss</groupId>
	<artifactId>armstrong</artifactId>
	<version>1.0</version>
	<properties>
		<maven.compiler.release>11</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<suite>*</suite>
		<target.class>ro.tss.armstrong.Main</target.class>
		<jacoco.destFile>${project.build.directory}/jacoco.exec</jacoco.destFile>
	</properties>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<includes>
						<include>**/${suite}.java</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<append>false</append>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.17.4</version>
				<configuration>
					<targetClasses>
						<param>${target.class}</param>
					</targetClasses>
					<targetTests>
						<param>ro.tss.*.${suite}</param>
					</targetTests>
					<outputFormats>
						<param>XML</param>
						<param>HTML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
					<threads>2</threads>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>tools</id>
			<properties>
				<tss.tools>${project.basedir}/.tools</tss.tools>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>3.8.1</version>
						<executions>
							<execution>
								<id>fetch-tools</id>
								<phase>validate</phase>
								<goals>
									<goal>copy</goal>
								</goals>
								<configuration>
									<outputDirectory>${tss.tools}</outputDirectory>
									<artifactItems>
										<artifactItem>
											<groupId>junit</groupId>
											<artifactId>junit</artifactId>
											<version>4.13.2</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.hamcrest</groupId>
											<artifactId>hamcrest-core</artifactId>
											<version>1.3</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.pitest</groupId>
											<artifactId>pitest</artifactId>
											<version>1.17.4</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.pitest</groupId>
											<artifactId>pitest-entry</artifactId>
											<version>1.17.4</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.pitest</groupId>
											<artifactId>pitest-command-line</artifactId>
											<version>1.17.4</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.apache.commons</groupId>
											<artifactId>commons-text</artifactId>
											<version>1.12.0</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.apache.commons</groupId>
											<artifactId>commons-lang3</artifactId>
											<version>3.14.0</version>
										</artifactItem>
										<artifactItem>
											<groupId>org.jacoco</groupId>
											<artifactId>org.jacoco.agent</artifactId>
											<version>0.8.13</version>
											<classifier>runtime</classifier>
											<destFileName>jacoco-agent-0.8.13.jar</destFileName>
										</artifactItem>
										<artifactItem>
											<groupId>org.jacoco</groupId>
											<artifactId>org.jacoco.cli</artifactId>
											<version>0.8.13</version>
											<classifier>nodeps</classifier>
											<destFileName>jacoco-cli-0.8.13.jar</destFileName>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>major-setup</id>
			<properties>
				<major.version>3.0.1</major.version>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>com.googlecode.maven-download-plugin</groupId>
						<artifactId>download-maven-plugin</artifactId>
						<version>1.9.0</version>
						<executions>
							<execution>
								<id>get-major</id>
								<phase>validate</phase>
								<goals>
									<goal>wget</goal>
								</goals>
								<configuration>
									<url>https://mutation-testing.org/downloads/major-${major.version}_jre11.zip</url>
									<unpack>true</unpack>
									<outputDirectory>${project.basedir}/.tools</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>major</id>
			<properties>
				<major.home>${project.basedir}/.tools/major</major.home>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<compilerArgs>
								<arg>-XDcompilePolicy=simple</arg>
								<arg>-processorpath</arg>
								<arg>${major.home}/lib/major.jar</arg>
								<arg>-Xplugin:MajorPlugin mml:${major.home}/mml/all.mml.bin</arg>
							</compilerArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
