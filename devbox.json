{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "python@latest",
    "maven@latest",
    "jdk17@latest",
    "path:./nix/texlive"
  ],
  "shell": {
    "init_hook": [
      "export TSS_TOOLS=\"${TSS_TOOLS:-$PWD/.tools}\"",
      "export TSS_JDK11=\"${TSS_JDK11:-$TSS_TOOLS/jdk11/lib/openjdk}\""
    ],
    "scripts": {
      "setup:tools": [
        "mvn -q -Ptools validate -Dtss.tools=\"$TSS_TOOLS\""
      ],
      "setup:major": [
        "mvn -q -Pmajor-setup validate"
      ],
      "setup:jdk11": [
        "nix build --extra-experimental-features 'nix-command flakes' nixpkgs#jdk11 -o \"$TSS_TOOLS/jdk11\""
      ],
      "setup": [
        "devbox run setup:tools",
        "devbox run setup:jdk11",
        "devbox run setup:major"
      ],
      "prepare": [
        "mvn generate-test-resources"
      ],
      "test": [
        "mvn test"
      ],
      "run": [
        "python3 scripts/run.py \"${1:-all}\""
      ],
      "raports": [
        "devbox run prepare",
        "rm -rf raports",
        "devbox run run"
      ],
      "validate": [
        "python3 scripts/analiza_mutatiilor.py"
      ],
      "pdf": [
        "pdflatex main.tex",
        "latexmk -c main.tex",
        "mv main.pdf Prezentare.pdf"
      ]
    }
  }
}
